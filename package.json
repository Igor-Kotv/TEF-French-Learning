{
  "name": "tef-french-learning",
  "version": "0.1.0",
  "description": "Lightweight TEF French writing practice app.",
  "author": "Ihor Kotvytskyi",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "main": "out/main/index.cjs",
  "scripts": {
    "build": "tsc -b && electron-vite build",
    "dev": "node scripts/run-electron-vite.mjs dev",
    "dist:mac": "pnpm build && electron-builder --mac",
    "ios:add": "cap add ios",
    "ios:open": "cap open ios",
    "ios:sync": "vite build && cap sync ios",
    "package:mac": "pnpm build && electron-builder --mac --dir",
    "prepare:ocr": "node scripts/prepare-ocr-assets.mjs",
    "prebuild": "node scripts/prepare-ocr-assets.mjs",
    "predev": "node scripts/prepare-ocr-assets.mjs",
    "preios:sync": "node scripts/prepare-ocr-assets.mjs",
    "prepreview": "node scripts/prepare-ocr-assets.mjs",
    "preweb:build": "node scripts/prepare-ocr-assets.mjs",
    "preweb:dev": "node scripts/prepare-ocr-assets.mjs",
    "preview": "node scripts/run-electron-vite.mjs preview",
    "test": "vitest run",
    "typecheck": "tsc -b && tsc --noEmit -p electron/tsconfig.json",
    "web:build": "vite build",
    "web:dev": "vite --host 0.0.0.0"
  },
  "build": {
    "appId": "com.tef.frenchlearning",
    "productName": "TEF French Learning",
    "asar": true,
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.education",
      "identity": null,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.4.2",
    "@tesseract.js-data/fra": "^1.0.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
